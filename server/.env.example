# 推理方案：stub（占位）| local（本地 GPU 服务）| remote（第三方 API）
VTON_INFERENCE_PROVIDER=stub

# 本地推理服务地址（inference/service.py 默认跑在 9000 端口）
VTON_LOCAL_INFERENCE_URL=http://127.0.0.1:9000

# 对外可访问的 API 地址，用于拼接图片 URL
VTON_PUBLIC_BASE_URL=http://localhost:8000

# 允许跨域的前端地址，多个用逗号分隔
VTON_CORS_ORIGINS=http://localhost:3000

# 第三方推理 API（remote 模式才需要）
VTON_REMOTE_API_URL=
VTON_REMOTE_API_KEY=
